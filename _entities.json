  "name": "Medication",
  "type": "object",
  "properties": {
   "name": {
    "type": "string",
    "title": "اسم الدواء"
   },
   "generic_name": {
    "type": "string",
    "title": "الاسم العلمي"
   },
   "dosage": {
    "type": "string",
    "title": "الجرعة",
    "description": "مقدار الجرعة الواحدة"
   },
   "dosage_unit": {
    "type": "string",
    "title": "وحدة الجرعة",
    "enum": [
     "حبة",
     "ملغ",
     "مل",
     "قطرة",
     "بخة",
     "حقنة",
     "أخرى"
    ],
    "default": "حبة"
   },
   "form": {
    "type": "string",
