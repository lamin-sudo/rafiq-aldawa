   "end_date": {
    "type": "string",
    "format": "date",
    "title": "تاريخ النهاية"
   },
   "instructions": {
    "type": "string",
    "title": "تعليمات الاستخدام"
   },
   "notes": {
    "type": "string",
    "title": "ملاحظات"
   },
   "quantity": {
    "type": "number",
    "title": "الكمية الكلية",
    "minimum": 0,
    "default": 0
   },
   "remaining_quantity": {
    "type": "number",
    "title": "الكمية المتبقية",
    "minimum": 0,
    "default": 0
   },
   "refill_threshold": {
    "type": "number",
    "title": "حد إعادة التعبئة",
    "minimum": 0,
    "default": 5
   },
   "active": {
    "type": "boolean",
    "title": "نشط",
    "default": true
   },
   "recipient_id": {
    "type": "string",
    "title": "الشخص المرافق"
   },
   "recipient_name": {
    "type": "string",
    "title": "اسم الشخص"
   },
   "color": {
    "type": "string",
    "title": "لون مميز",
    "default": "teal"
   },
   "shared_with": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "title": "مشاركة مع",
    "default": []
   },
   "calendar_event_ids": {
    "type": "array",
    "items": {
     "type": "string"
    },
