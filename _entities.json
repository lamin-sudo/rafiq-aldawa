     "حقن",
     "كريم",
     "قطرة",
     "بخاخ",
     "أخرى"
    ],
    "default": "أقراص"
   },
   "frequency_per_day": {
    "type": "number",
    "title": "عدد المرات يوميًا",
    "minimum": 1,
    "maximum": 12,
    "default": 1
   },
   "scheduled_times": {
    "type": "array",
